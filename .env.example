# Application Settings
PROJECT_NAME="Visual AI/ML Pipeline Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="development-secret-key-change-in-production"

# Database Configuration (Defaults to SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./data/platform.db"
# POSTGRES_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/platform_db"

# Storage Settings
STORAGE_BACKEND="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./data/storage"

# S3 / MinIO Settings (When STORAGE_BACKEND=s3)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="pipeline-artifacts"

# MLflow Settings
MLFLOW_TRACKING_URI="sqlite:///./data/mlflow.db"
